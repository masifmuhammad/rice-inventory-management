# ---------------------------------------------------------------- required ---

# PostgreSQL connection string.
# Docker Compose (Postgres service): use the URL below.
# Local `npm run dev` while Compose is up: same URL (port 5432 is published).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rice_inventory

# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot in production without this.
JWT_SECRET=

# ---------------------------------------------------------------- optional ---

NODE_ENV=development
PORT=5000

# How long a login lasts.
JWT_EXPIRES_IN=30d

# Used for calendar dates in reports, cash book and audit filters.
REPORT_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# Only needed when the frontend is hosted on a DIFFERENT domain than the API.
# The Docker image serves both from one origin, so leave this blank there.
# CORS_ORIGINS=https://other-origin.example.com,https://www.yourdomain.com

# Absolute path to the built frontend. Auto-detected in both the Docker image
# and the local repo layout, so you normally do not need to set this.
# CLIENT_BUILD_PATH=/app/public

# ------------------------------------------------------------------ seeding ---
# Used by `npm run seed` to create the first admin account.
# Run once after deploy: cd backend && npm run seed
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_BUSINESS_NAME=
# Optional second business; no sample business is created by default.
SEED_SECOND_BUSINESS=
# New admins must choose their own password at first login.
SEED_FORCE_PASSWORD_CHANGE=true
# Leave false for normal seeding. True explicitly resets an existing account.
SEED_RESET_EXISTING=false

# --------------------------------------------------------------------- AI ---
# OpenRouter powers the in-app assistant (chat, voice, briefing, scan).
# Get a key at https://openrouter.ai — keep it server-side only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FREE=openrouter/free
OPENROUTER_MODEL_PAID=meta-llama/llama-3.1-8b-instruct
OPENROUTER_STT=openai/whisper-1
OPENROUTER_STT_FALLBACK=openai/whisper-large-v3
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_SITE_NAME=Rice Inventory
